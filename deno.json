{
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "dashi",
    "lib": [
      "dom",
      "deno.ns"
    ]
  },
  "workspace": [
    "./examples/hello-world",
    "./examples/fragments"
  ],
  "vendor": true,
  "lock": {
    "frozen": true
  },
  "minimumDependencyAge": "P1D",
  "lint": {
    "rules": {
      "exclude": [
        "jsx-key"
      ],
      "include": [
        "no-process-global",
        "no-node-globals"
      ]
    }
  },
  "tasks": {
    "dev": "deno run --watch main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing": "jsr:@std/testing@^1.0.18",
    "dashi/jsx-runtime": "./jsx-runtime/mod.ts"
  },
  "exports": {
    ".": "./mod.ts"
  }
}
