{
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "dashi",
    "lib": [
      "dom",
      "deno.ns",
      "deno.unstable"
    ]
  },
  "workspace": [
    "./examples/hello-world",
    "./examples/fragments",
    "./int-tests",
    "./e2e"
  ],
  "unstable": ["bundle"],
  "lock": {
    "frozen": true
  },
  "minimumDependencyAge": "P1D",
  "fmt": {
    "useBraces": "always",
    "singleBodyPosition": "nextLine"
  },
  "lint": {
    "rules": {
      "exclude": [
        "jsx-key"
      ],
      "include": [
        "no-process-global",
        "no-node-globals"
      ]
    }
  },
  "tasks": {
    "test": "deno test -A --ignore=int-tests/,e2e/",
    "test:int": "deno test -A int-tests/",
    "test:e2e": "deno test -A --junit-path=e2e/results/junit.xml e2e/",
    "test:e2e:headed": "DASHI_E2E_HEADED=1 deno test -A e2e/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "dashi/jsx-runtime": "./jsx-runtime/mod.ts"
  },
  "name": "@cookingpot/dashi",
  "version": "0.0.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./jsx-runtime": "./jsx-runtime/mod.ts",
    "./cors": "./cors/mod.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "README.md",
      "LICENSE",
      "caching",
      "client",
      "cors",
      "fragments",
      "jsx-runtime",
      "logging",
      "routing",
      "serve",
      "shared",
      "ssr",
      "static"
    ],
    "exclude": ["**/*_test.ts", "**/*_test.tsx"]
  }
}
