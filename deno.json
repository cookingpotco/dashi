{
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "dashi",
    "lib": [
      "dom",
      "deno.ns"
    ]
  },
  "workspace": [
    "./examples/hello-world",
    "./examples/fragments",
    "./int-tests",
    "./e2e"
  ],
  "lock": {
    "frozen": true
  },
  "minimumDependencyAge": "P1D",
  "fmt": {
    "useBraces": "always",
    "singleBodyPosition": "nextLine"
  },
  "lint": {
    "rules": {
      "exclude": [
        "jsx-key"
      ],
      "include": [
        "no-process-global",
        "no-node-globals"
      ]
    }
  },
  "tasks": {
    "dev": "deno run --watch main.ts",
    "test": "deno test -A --ignore=int-tests/,e2e/",
    "test:int": "deno test -A int-tests/",
    "test:e2e": "deno test -A --junit-path=e2e/results/junit.xml e2e/",
    "test:e2e:headed": "DASHI_E2E_HEADED=1 deno test -A e2e/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "dashi/jsx-runtime": "./jsx-runtime/mod.ts"
  },
  "exports": {
    ".": "./mod.ts",
    "./cors": "./cors/mod.ts"
  }
}
